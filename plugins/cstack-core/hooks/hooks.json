{
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "test -f \"${CLAUDE_PLUGIN_ROOT}/scripts/statusline/setup-statusline.sh\" && bash \"${CLAUDE_PLUGIN_ROOT}/scripts/statusline/setup-statusline.sh\" || true"
      }]
    }],
    "Notification": [{
      "hooks": [{
        "type": "command",
        "command": "test -f \"${CLAUDE_PLUGIN_ROOT}/scripts/play-sound/play_sound.py\" && python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/play-sound/play_sound.py\" || true"
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "test -f \"${CLAUDE_PLUGIN_ROOT}/scripts/play-sound/play_sound.py\" && python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/play-sound/play_sound.py\" || true"
      }]
    }],
    "PreToolUse": [{
      "matcher": "Edit|MultiEdit|Write|NotebookEdit|TodoWrite|Bash",
      "hooks": [{
        "type": "command",
        "command": "test -f \"${CLAUDE_PLUGIN_ROOT}/scripts/play-sound/play_sound.py\" && python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/play-sound/play_sound.py\" || true"
      }]
    }]
  }
}
